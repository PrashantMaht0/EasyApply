# Model provider: bedrock | ollama
MODEL_PROVIDER=bedrock

# ————— Bedrock —————
AWS_REGION=
# Bedrock needs an inference profile id, not a bare model id. Verified working:
#   global.amazon.nova-2-lite-v1:0   or  global.anthropic.claude-sonnet-4-6
BEDROCK_MODEL_ID=global.amazon.nova-2-lite-v1:0
# The high volume scorer stage. Nova 2 Lite measured better AND cheaper than Nova Lite here,
# so both tiers use it. Alternatives: us.amazon.nova-lite-v1:0, which has no global. profile,
# or global.anthropic.claude-haiku-4-5-20251001-v1:0 on an account with Anthropic access.
BEDROCK_SCORER_MODEL_ID=global.amazon.nova-2-lite-v1:0
# Only needed when there is no ~/.aws profile on the machine
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ————— Local model fallback —————
OLLAMA_HOST=
OLLAMA_MODEL_ID=

# ————— Run limits —————
# V8 budget guard, the run halts before the next agent call rather than exceeding this
EASEAPPLY_BUDGET_USD=0.50

# Runtime backend: local | agentcore
EASEAPPLY_BACKEND=local

# SQLite blackboard path, defaults to data/easeapply.db
EASEAPPLY_DB=

# ————— Daily digest —————
# Delivery: smtp | ses | none. none renders the HTML and skips sending
EMAIL_BACKEND=none
# The only recipient, your own address
SELF_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Tracing is ADOT now. The deployed runtime ships spans to CloudWatch by itself, so these two
# only matter locally, and only when the app is started under opentelemetry-instrument:
#   docker run --rm -p 6006:6006 arizephoenix/phoenix
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:6006 opentelemetry-instrument python app.py
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=easeapply

# AgentCore. Blank runs the pipeline in this process, which is the local default. Set the ARN
# after a deploy and the dashboard invokes the runtime over SigV4 instead.
EASEAPPLY_RUNTIME_ARN=
# The blackboard the runtime reads and writes, since an AgentCore session starts on a blank disk
EASEAPPLY_S3_BUCKET=
EASEAPPLY_S3_KEY=easeapply.db
