{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Blackboard",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::easeapply-blackboard-237602474050/*"
    },
    {
      "Sid": "BlackboardList",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::easeapply-blackboard-237602474050"
    },
    {
      "Sid": "DigestEmail",
      "Effect": "Allow",
      "Action": [
        "ses:SendEmail",
        "ses:SendRawEmail"
      ],
      "Resource": "*"
    }
  ]
}
